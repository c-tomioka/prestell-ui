#!/bin/sh
# Opt-in secret scan of staged changes. Enable with:
#   git config core.hooksPath .githooks
# Requires gitleaks (https://github.com/gitleaks/gitleaks): brew install gitleaks
if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks not installed, skipping secret scan (brew install gitleaks)" >&2
	exit 0
fi
exec gitleaks git --staged --no-banner --redact
