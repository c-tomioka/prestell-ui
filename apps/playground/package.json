{
	"name": "@prestell/playground",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"dev:server": "cross-env PUBLIC_PREVIEW_RENDERER=server astro dev",
		"dev:stop": "astro dev stop",
		"build": "astro build",
		"build:server": "cross-env PUBLIC_PREVIEW_RENDERER=server astro build",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"types": "wrangler types src/worker-configuration.d.ts --include-runtime false",
		"astro": "astro",
		"eval": "cross-env PRESTELL_EVAL=1 vitest run scripts/eval --testTimeout=3600000"
	},
	"dependencies": {
		"@ai-sdk/mcp": "^2.0.44",
		"@ai-sdk/openai-compatible": "^3.0.43",
		"@ai-sdk/svelte": "^5.0.92",
		"@astrojs/cloudflare": "^14.2.0",
		"@astrojs/compiler-binding-wasm32-wasi": "^0.2.2",
		"@astrojs/svelte": "^9.0.1",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.4",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.7.1",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.8",
		"@prestell/codemirror-astro": "workspace:*",
		"ai": "^7.0.92",
		"astro": "7.2.0",
		"codemirror": "^6.0.2",
		"svelte": "^5.56.8",
		"vite": "^8.2.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/compiler-binding": "^0.3.2",
		"@types/node": "^24.13.3",
		"cross-env": "^10.1.0",
		"fake-indexeddb": "^6.2.5",
		"rolldown": "^1.2.3",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10",
		"wrangler": "^4.119.0"
	}
}
