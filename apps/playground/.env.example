# Copy to `.env` (git-ignored) only if you want to change build-time settings.
# Secrets do NOT go here: API keys and tokens belong in `.dev.vars` (see `.dev.vars.example`).

# Where the preview is rendered: browser (default, Web Worker) or server (/api/render, Worker Loader).
# `pnpm dev:server` sets this for you.
#PUBLIC_PREVIEW_RENDERER=browser
