# Copy to `.dev.vars` (git-ignored). Loaded automatically by `astro dev` (Cloudflare adapter).
# Local LLMs (no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Cloudflare AI Gateway (external LLMs). Paste the REST API URL shown in the dashboard:
#   https://api.cloudflare.com/client/v4/accounts/<account_id>/ai      (the trailing /run or /v1/... is fine)
# Legacy form also works: https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>
CF_AI_GATEWAY_URL=
# Cloudflare API token with "Account > Workers AI > Read" (add "AI Gateway > Read" for the legacy form)
CF_AI_GATEWAY_TOKEN=
# Gateway name (e.g. default). Required for Workers AI, optional for third-party models
CF_AI_GATEWAY_ID=
# Provider keys: when set, they are passed through the gateway to the provider (BYOK passthrough).
# When empty, the gateway's own BYOK stored keys / Unified Billing balance are used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Astro Docs MCP
ASTRO_DOCS_MCP_URL=https://mcp.docs.astro.build/mcp
