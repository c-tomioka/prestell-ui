{
	"name": "prestell-ui",
	"private": true,
	"version": "0.0.0",
	"description": "AI chat builder for Astro: generate .astro components, validate them with the Astro compiler, preview in the browser.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/c-tomioka/prestell-ui.git"
	},
	"homepage": "https://github.com/c-tomioka/prestell-ui#readme",
	"bugs": {
		"url": "https://github.com/c-tomioka/prestell-ui/issues"
	},
	"type": "module",
	"packageManager": "pnpm@11.5.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --filter @prestell/playground run dev",
		"dev:server": "pnpm --filter @prestell/playground run dev:server",
		"dev:stop": "pnpm --filter @prestell/playground run dev:stop",
		"build": "pnpm --filter @prestell/playground run build",
		"build:server": "pnpm --filter @prestell/playground run build:server",
		"check": "pnpm --filter @prestell/playground --filter @prestell/codemirror-astro run check",
		"test": "pnpm --filter @prestell/playground run test",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"lang:build": "pnpm --filter @prestell/codemirror-astro run build",
		"eval": "pnpm --filter @prestell/playground run eval"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7"
	}
}
